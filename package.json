{
  "name": "@emulsify/core",
  "version": "3.5.1",
  "description": "Bundled tooling for Storybook development + Webpack Build",
  "keywords": [
    "component library",
    "design system",
    "drupal",
    "pattern library",
    "storybook",
    "styleguide"
  ],
  "author": "Four Kitchens <shout@fourkitchens.com>",
  "license": "GPL-2.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emulsify-ds/emulsify-core.git"
  },
  "bugs": {
    "url": "https://github.com/emulsify-ds/emulsify-core/issues"
  },
  "homepage": "https://github.com/emulsify-ds/emulsify-core#readme",
  "publishConfig": {
    "access": "public",
    "tag": "legacy-3"
  },
  "config": {
    "scripts-prepend-node-path": "auto"
  },
  "scripts": {
    "coverage": "npm run test && open-cli .coverage/lcov-report/index.html",
    "format": "npm run lint-fix; npm run prettier-fix",
    "husky:commit-msg": "commitlint --edit $1",
    "husky:pre-commit": "npm run lint",
    "lint": "npm run lint-js",
    "lint-fix": "npm run lint-js -- --fix",
    "lint-js": "eslint --config config/eslint.config.js --no-error-on-unmatched-pattern ./config ./.storybook",
    "lint-staged": "lint-staged",
    "prepare": "[ -d '.git' ] && (husky install) || true",
    "prettier": "prettier --config config/.prettierrc.json --ignore-unknown \"**/*.{js,yml,scss,md}\"",
    "prettier-fix": "prettier --config config/.prettierrc.json --write --ignore-unknown \"**/*.{js,yml,scss,md}\"",
    "semantic-release": "semantic-release --config ./release.config.cjs",
    "storybook": "NODE_OPTIONS=--no-deprecation storybook dev --ci -p 6006",
    "storybook-build": "storybook build -o .out",
    "storybook-deploy": "storybook-to-ghpages -o .out",
    "test": "jest --coverage  --config ./config/jest.config.js",
    "twatch": "jest --no-coverage --watch --verbose",
    "test:release": "node scripts/verify-maintenance-release.cjs",
    "test:resolver": "node scripts/verify-resolver-installer.cjs",
    "test:consumer": "node scripts/verify-maintenance-consumer.cjs",
    "test:builds": "node scripts/verify-maintenance-builds.cjs",
    "test:images": "node scripts/verify-image-optimizer.mjs"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@emulsify/cli": "^1.12.2",
    "@eslint/js": "^10.0.1",
    "@napi-rs/image": "^1.16.0",
    "@storybook/addon-a11y": "^9.1.21",
    "@storybook/addon-links": "^9.1.21",
    "@storybook/addon-styling-webpack": "^2.0.0",
    "@storybook/addon-themes": "^9.1.21",
    "@storybook/builder-webpack5": "^9.1.21",
    "@storybook/server-webpack5": "^9.1.21",
    "add-attributes-twig-extension": "^0.1.0",
    "autoprefixer": "^10.6.2",
    "axe-core": "^4.14.0",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "babel-preset-minify": "^0.5.2",
    "bem-twig-extension": "^0.1.1",
    "breakpoint-sass": "^3.0.0",
    "concurrently": "^10.0.6",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-security": "^4.2.0",
    "fs-extra": "^11.4.1",
    "glob": "^14.0.3",
    "graceful-fs": "^4.2.11",
    "html-webpack-plugin": "^5.6.8",
    "image-minimizer-webpack-plugin": "^5.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "js-yaml": "^4.3.2",
    "js-yaml-loader": "^1.2.2",
    "mini-css-extract-plugin": "^2.10.2",
    "normalize.css": "^8.0.1",
    "open-cli": "^9.0.0",
    "pa11y": "^10.0.0",
    "postcss": "^8.5.32",
    "postcss-loader": "^8.2.1",
    "postcss-scss": "^4.0.9",
    "process": "^0.11.10",
    "ramda": "^0.32.0",
    "regenerator-runtime": "^0.14.1",
    "sass": "^1.106.1",
    "sass-loader": "^16.0.8",
    "storybook": "^9.1.21",
    "style-dictionary": "^5.7.1",
    "style-loader": "^4.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3",
    "stylelint-webpack-plugin": "^5.1.0",
    "svg-spritemap-webpack-plugin": "^5.1.5",
    "terser-webpack-plugin": "^5.6.1",
    "token-transformer": "^0.0.33",
    "twig": "^1.17.1",
    "twig-drupal-filters": "^3.2.0",
    "twig-testing-library": "^1.2.0",
    "twigjs-loader": "^1.0.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.2.3",
    "webpack-merge": "^6.0.1",
    "webpack-remove-empty-scripts": "^1.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "all-contributors-cli": "^7.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "semantic-release": "^25.0.9"
  }
}
